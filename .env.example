# Postgres (app database)
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_NAME=your_db_name_here

# Keycloak DB (riêng, không dùng chung với app)
KEYCLOAK_DB_USER=your_keycloak_db_user_here
KEYCLOAK_DB_PASSWORD=your_keycloak_db_password_here
KEYCLOAK_DB_NAME=keycloak

# Keycloak admin
KEYCLOAK_ADMIN_USER=your_keycloak_admin_user_here 
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password_here
KEYCLOAK_REALM=your_keycloak_realm_here

# External API
WAQI_API_TOKEN=your_waqi_token_here
WAQI_BASE_URL=https://api.waqi.info
RESEND_API_KEY=your_resend_key_here
RESEND_FROM_EMAIL=AQI Health Monitor <onboarding@resend.dev>

# Redis (cache + Asynq)
REDIS_ADDR=localhost:6379

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:alerts@aqi-health-monitor.local