# Postgres (app database)
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_NAME=your_db_name_here

# Keycloak DB (riêng, không dùng chung với app)
KEYCLOAK_DB_USER=your_keycloak_db_user_here
KEYCLOAK_DB_PASSWORD=your_keycloak_db_password_here
KEYCLOAK_DB_NAME=keycloak

# Keycloak admin
KEYCLOAK_ADMIN_USER=your_keycloak_admin_user_here 
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password_here
KEYCLOAK_REALM=your_keycloak_realm_here

# External API
WAQI_API_TOKEN=your_waqi_token_here
RESEND_API_KEY=your_resend_key_here